# shellcheck shell=bash
#
# Single source of truth for pinned toolchain versions used by local scripts and
# CI. This file is sourced, never executed:
#
#     source "$ROOT/scripts/toolchain.env"
#
# Keep it LF-only and free of side effects. Every consumer must read the pins
# from these variables instead of repeating the literals.

# Rust toolchain channel: must match `channel` in both crates'
# rust-toolchain.toml and `rust-version` in both Cargo.toml files.
RUST_TOOLCHAIN="1.97.1"
# Zig used by cargo-zigbuild for the static Linux server build.
ZIG_VERSION="0.17.0"
# cargo-ndk used by the Android client build.
CARGO_NDK_VERSION="4.1.2"
# cargo-zigbuild used for the Linux server build.
CARGO_ZIGBUILD_VERSION="0.24.0"
# Android NDK (must exist as $ANDROID_HOME/ndk/<version>).
ANDROID_NDK_VERSION="27.0.12077973"
# Android build-tools version.
ANDROID_BUILD_TOOLS_VERSION="37.0.0"
# Android platform directory name (compileSdk/targetSdk 37).
ANDROID_PLATFORM="android-37.0"

export RUST_TOOLCHAIN ZIG_VERSION CARGO_NDK_VERSION CARGO_ZIGBUILD_VERSION
export ANDROID_NDK_VERSION ANDROID_BUILD_TOOLS_VERSION ANDROID_PLATFORM
